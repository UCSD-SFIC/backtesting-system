# Copy to .env (ignored by Git) and fill in.

# Required for the research terminal. The SEC asks every client to identify
# itself with a name and a contact email, and blocks requests that do not.
SEC_USER_AGENT="SFIC Research Terminal yourname@ucsd.edu"

# Optional. Where the terminal keeps its database, raw SEC payloads and prices.
# TERMINAL_DATA_DIR=terminal_data
# TERMINAL_DATABASE_URL=sqlite:///terminal_data/terminal.sqlite3

# Optional. Price source for the terminal: yfinance (default) or polygon.
# TERMINAL_PRICE_PROVIDER=yfinance
# POLYGON_API_KEY=
